// Cloudflare Worker static-assets deploy: `astro build` then `wrangler deploy`.
// `main` runs worker/index.js (handles POST /api/send-email for the contact form)
// and delegates every other request to the static assets via the ASSETS binding.
//
// The contact form needs two values the DEPLOYER sets (not committed here):
//   npx wrangler secret put RESEND_API_KEY     # your Resend API key
//   npx wrangler secret put TO_EMAIL           # inbox that receives submissions
// FROM defaults to onboarding@resend.dev (Resend sandbox, no domain verification).
{
  "name": "starter-variables-01-astro-astro-tmp-1781344344718-v4hf95",
  "compatibility_date": "2026-06-13",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}
