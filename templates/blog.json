{
  "root": {
    "type": "component",
    "component": "Layout",
    "children": [
      {
        "type": "component",
        "component": "Navigation"
      },
      {
        "type": "node",
        "tag": "section",
        "style": {
          "base": {
            "padding": "var(--s-p)",
            "backgroundColor": "var(--bg)"
          },
          "tablet": {},
          "mobile": {}
        },
        "children": [
          {
            "type": "node",
            "tag": "container",
            "style": {
              "base": {
                "display": "block",
                "maxWidth": "var(--co-s)",
                "margin": "auto"
              },
              "tablet": {},
              "mobile": {}
            },
            "children": [
              {
                "type": "node",
                "tag": "span",
                "style": {
                  "base": {
                    "display": "inline-block",
                    "padding": "4px 12px",
                    "backgroundColor": "var(--gray-100)",
                    "borderRadius": "999px",
                    "fontSize": "14px",
                    "fontWeight": "500",
                    "color": "var(--text)",
                    "marginBottom": "16px"
                  },
                  "tablet": {},
                  "mobile": {}
                },
                "children": "{{cms.category}}"
              },
              {
                "type": "node",
                "tag": "h1",
                "style": {
                  "base": {
                    "fontSize": "var(--h-fs)",
                    "letterSpacing": "var(--h-ls)",
                    "fontWeight": "var(--h-fw)",
                    "lineHeight": "var(--h-lh)",
                    "color": "var(--text)",
                    "marginBottom": "var(--h-m)"
                  },
                  "tablet": {},
                  "mobile": {}
                },
                "children": "{{cms.title}}"
              },
              {
                "type": "node",
                "tag": "span",
                "style": {
                  "base": {
                    "fontSize": "var(--t-fs)",
                    "letterSpacing": "var(--t-ls)",
                    "fontWeight": "var(--t-fw)",
                    "color": "var(--muted)"
                  },
                  "tablet": {},
                  "mobile": {}
                },
                "children": "{{cms.date}}"
              },
              {
                "type": "node",
                "tag": "img",
                "style": {
                  "base": {
                    "width": "100%",
                    "aspectRatio": "16 / 9",
                    "objectFit": "cover",
                    "borderRadius": "8px",
                    "marginTop": "32px",
                    "marginBottom": "32px"
                  },
                  "tablet": {},
                  "mobile": {}
                },
                "attributes": {
                  "src": "{{cms.image}}",
                  "alt": "{{cms.title}}"
                }
              },
              {
                "type": "node",
                "tag": "p",
                "style": {
                  "base": {
                    "fontSize": "var(--t-fs)",
                    "letterSpacing": "var(--t-ls)",
                    "fontWeight": "var(--t-fw)",
                    "lineHeight": "var(--t-lh)",
                    "color": "var(--text)"
                  },
                  "tablet": {},
                  "mobile": {}
                },
                "children": "{{cms.description}}"
              },
              {
                "type": "node",
                "tag": "div",
                "style": {
                  "base": {
                    "fontSize": "var(--t-fs)",
                    "letterSpacing": "var(--t-ls)",
                    "fontWeight": "var(--t-fw)",
                    "lineHeight": "var(--t-lh)",
                    "color": "var(--text)",
                    "marginTop": "24px"
                  },
                  "tablet": {},
                  "mobile": {}
                },
                "children": "{{cms.content}}"
              }
            ]
          }
        ]
      },
      {
        "type": "component",
        "component": "Footer"
      }
    ]
  },
  "meta": {
    "title": "{{cms.title}}",
    "description": "{{cms.description}}",
    "source": "cms",
    "cms": {
      "id": "blog",
      "name": "Blog",
      "slugField": "slug",
      "urlPattern": "/blog/{{slug}}",
      "fields": {
        "title": {
          "type": "string",
          "label": "Title",
          "required": true
        },
        "slug": {
          "type": "string",
          "label": "URL Slug",
          "required": true
        },
        "category": {
          "type": "string",
          "label": "Category"
        },
        "date": {
          "type": "string",
          "label": "Date"
        },
        "description": {
          "type": "text",
          "label": "Description"
        },
        "image": {
          "type": "image",
          "label": "Cover image"
        },
        "content": {
          "type": "rich-text",
          "label": "Content"
        }
      }
    }
  }
}