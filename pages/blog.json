{
  "root": {
    "type": "component",
    "component": "Layout",
    "children": [
      {
        "type": "component",
        "component": "Navigation"
      },
      {
        "type": "node",
        "tag": "section",
        "style": {
          "base": {
            "padding": "var(--s-p)",
            "backgroundColor": "var(--bg)"
          },
          "tablet": {},
          "mobile": {}
        },
        "children": [
          {
            "type": "node",
            "tag": "container",
            "style": {
              "base": {
                "display": "block",
                "maxWidth": "var(--c-s)",
                "margin": "auto"
              },
              "tablet": {},
              "mobile": {}
            },
            "children": [
              {
                "type": "node",
                "tag": "div",
                "style": {
                  "base": {
                    "display": "flex",
                    "flexDirection": "column",
                    "justifyContent": "flex-start",
                    "alignItems": "center",
                    "textAlign": "center",
                    "marginBottom": "52px"
                  },
                  "tablet": {},
                  "mobile": {}
                },
                "children": [
                  {
                    "type": "node",
                    "tag": "span",
                    "style": {
                      "base": {
                        "fontSize": "var(--s-fs)",
                        "letterSpacing": "var(--s-ls)",
                        "fontWeight": "var(--s-fw)",
                        "color": "var(--text)",
                        "textTransform": "var(--subtitle)",
                        "marginBottom": "var(--s-m)"
                      },
                      "tablet": {},
                      "mobile": {}
                    },
                    "children": "Blog"
                  },
                  {
                    "type": "node",
                    "tag": "h1",
                    "style": {
                      "base": {
                        "fontSize": "var(--h-fs)",
                        "letterSpacing": "var(--h-ls)",
                        "fontWeight": "var(--h-fw)",
                        "marginBottom": "var(--h-m)",
                        "lineHeight": "var(--h-lh)",
                        "color": "var(--text)",
                        "textAlign": "center"
                      },
                      "tablet": {},
                      "mobile": {}
                    },
                    "children": "All articles"
                  },
                  {
                    "type": "node",
                    "tag": "p",
                    "style": {
                      "base": {
                        "fontSize": "var(--t-fs)",
                        "letterSpacing": "var(--t-ls)",
                        "fontWeight": "var(--t-fw)",
                        "lineHeight": "var(--t-lh)",
                        "color": "var(--text)",
                        "textAlign": "center",
                        "maxWidth": "520px"
                      },
                      "tablet": {},
                      "mobile": {}
                    },
                    "children": "Browse every post, tutorial, and insight we've published."
                  }
                ]
              },
              {
                "type": "node",
                "tag": "div",
                "style": {
                  "base": {
                    "display": "grid",
                    "gridTemplateColumns": "1fr 1fr 1fr",
                    "gap": "16px"
                  },
                  "tablet": {},
                  "mobile": {}
                },
                "children": [
                  {
                    "type": "list",
                    "sourceType": "collection",
                    "source": "blog",
                    "itemAs": "post",
                    "sort": {
                      "field": "_createdAt",
                      "order": "desc"
                    },
                    "children": [
                      {
                        "type": "link",
                        "href": "{{post._url}}",
                        "style": {
                          "base": {
                            "display": "flex",
                            "flexDirection": "column",
                            "justifyContent": "flex-start",
                            "alignItems": "stretch",
                            "backgroundColor": "var(--bg)",
                            "borderRadius": "8px",
                            "overflow": "hidden",
                            "border": "1px solid",
                            "borderColor": "var(--border)",
                            "color": "var(--text)",
                            "textDecoration": "none"
                          },
                          "tablet": {},
                          "mobile": {}
                        },
                        "children": [
                          {
                            "type": "node",
                            "tag": "img",
                            "style": {
                              "base": {
                                "aspectRatio": "16 / 10",
                                "objectFit": "cover"
                              },
                              "tablet": {},
                              "mobile": {}
                            },
                            "attributes": {
                              "src": "{{post.image}}",
                              "alt": "{{post.title}}"
                            }
                          },
                          {
                            "type": "node",
                            "tag": "div",
                            "style": {
                              "base": {
                                "padding": "24px",
                                "display": "flex",
                                "flexDirection": "column",
                                "alignItems": "flex-start",
                                "gap": "12px"
                              },
                              "tablet": {},
                              "mobile": {}
                            },
                            "children": [
                              {
                                "type": "node",
                                "tag": "span",
                                "style": {
                                  "base": {
                                    "display": "inline-block",
                                    "padding": "4px 12px",
                                    "backgroundColor": "var(--gray-100)",
                                    "borderRadius": "999px",
                                    "fontSize": "var(--tex-fs)",
                                    "fontWeight": "500",
                                    "color": "var(--text)"
                                  },
                                  "tablet": {},
                                  "mobile": {}
                                },
                                "children": "{{post.category}}"
                              },
                              {
                                "type": "node",
                                "tag": "h3",
                                "style": {
                                  "base": {
                                    "fontSize": "var(--head-fs)",
                                    "letterSpacing": "var(--h-ls)",
                                    "fontWeight": "var(--h-fw)",
                                    "lineHeight": "var(--h-lh)",
                                    "color": "var(--text)",
                                    "margin": "0"
                                  },
                                  "tablet": {},
                                  "mobile": {}
                                },
                                "children": "{{post.title}}"
                              },
                              {
                                "type": "node",
                                "tag": "span",
                                "style": {
                                  "base": {
                                    "fontSize": "var(--te-fs)",
                                    "letterSpacing": "var(--t-ls)",
                                    "fontWeight": "var(--t-fw)",
                                    "color": "var(--muted)"
                                  },
                                  "tablet": {},
                                  "mobile": {}
                                },
                                "children": "{{post.date}}"
                              },
                              {
                                "type": "node",
                                "tag": "p",
                                "style": {
                                  "base": {
                                    "fontSize": "var(--t-fs)",
                                    "letterSpacing": "var(--t-ls)",
                                    "fontWeight": "var(--t-fw)",
                                    "lineHeight": "var(--t-lh)",
                                    "color": "var(--text)",
                                    "marginTop": "4px"
                                  },
                                  "tablet": {},
                                  "mobile": {}
                                },
                                "children": "{{post.description}}"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "component",
        "component": "Footer"
      }
    ]
  },
  "meta": {
    "title": "Blog",
    "description": "Browse all articles, tutorials, and insights."
  }
}
