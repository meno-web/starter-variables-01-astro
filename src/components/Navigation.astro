---
import { resolveProps, style } from 'meno-astro';
import { Link } from 'meno-astro/components';
import NavDropdown from './NavDropdown.astro';
import NavDropdownLink from './NavDropdownLink.astro';
import NavLink from './NavLink.astro';

const __props = resolveProps(Astro, {});
const { class: className } = __props;
---
<nav class={style({
    base: {
      display: "flex",
      alignItems: "center",
      justifyContent: "center",
      margin: "0 auto",
      position: "sticky",
      top: "0",
      backgroundColor: "var(--bg)",
      borderBottom: "1px solid var(--border)",
      zIndex: "100"
    },
    tablet: { height: "65px" },
    mobile: {}
  }, __props, { root: true, label: "Nav" })}>
  <div class={style({
      base: {
        display: "flex",
        alignItems: "center",
        justifyContent: "space-between",
        width: "100%",
        maxWidth: "var(--c-s)",
        padding: "0 32px"
      },
      tablet: { padding: "0 40px" },
      mobile: { padding: "0 20px" }
    }, __props, { label: "Container" })}>
    <input class={style({ base: { display: "none" }, tablet: {}, mobile: {} }, __props, { label: "MenuToggle" })} type="checkbox" id="menu-toggle" />
    <Link href="/" aria-label="Home">
      <span class={style({
          base: {
            color: "var(--text)",
            fontSize: "20px",
            fontWeight: "var(--h-fw)",
            letterSpacing: "var(--h-ls)"
          },
          tablet: {},
          mobile: {}
        }, __props, { label: "Logo" })}>Starter</span>
    </Link>
    <label class={style({
        base: { display: "none", cursor: "pointer" },
        tablet: {
          display: "flex",
          flexDirection: "column",
          gap: "4px",
          width: "28px",
          height: "24px",
          justifyContent: "center",
          zIndex: "101",
          marginLeft: "auto"
        },
        mobile: {}
      }, __props, { label: "HamburgerButton" })} for="menu-toggle" aria-label="Toggle menu">
      <span class={style({
          base: { display: "none" },
          tablet: {
            display: "block",
            width: "100%",
            height: "2px",
            backgroundColor: "var(--text)",
            transition: "all 0.3s ease"
          },
          mobile: {}
        }, __props, {
          interactive: [
            {
              prefix: "#menu-toggle:checked ~ label[for=\"menu-toggle\"] ",
              postfix: ":nth-child(1)",
              style: {
                base: { transform: "rotate(45deg) translate(2.5px, 2.5px)" },
                tablet: {},
                mobile: {}
              }
            }
          ],
          label: "Line1"
        })} />
      <span class={style({
          base: { display: "none" },
          tablet: {
            display: "block",
            width: "100%",
            height: "2px",
            backgroundColor: "var(--text)",
            transition: "all 0.3s ease"
          },
          mobile: {}
        }, __props, {
          interactive: [
            {
              prefix: "#menu-toggle:checked ~ label[for=\"menu-toggle\"] ",
              postfix: ":nth-child(2)",
              style: {
                base: { transform: "rotate(-45deg) translate(2.5px, -2.5px)" },
                tablet: {},
                mobile: {}
              }
            }
          ],
          label: "Line2"
        })} />
    </label>
    <div class={style({
        base: { display: "flex", alignItems: "center", gap: "16px" },
        tablet: {
          position: "absolute",
          top: "65px",
          left: "0",
          width: "100%",
          height: "calc(100vh - 65px)",
          flexDirection: "column",
          padding: "20px 40px",
          backgroundColor: "var(--bg)",
          zIndex: "99",
          transition: "opacity 0.3s ease, visibility 0.3s ease",
          alignItems: "flex-start",
          gap: "24px",
          overflow: "auto",
          opacity: "0",
          visibility: "hidden",
          pointerEvents: "none"
        },
        mobile: { padding: "20px" }
      }, __props, {
        interactive: [
          {
            name: "on Open",
            prefix: "#menu-toggle:checked ~",
            style: {
              base: {},
              tablet: { opacity: "1", visibility: "visible", pointerEvents: "auto" },
              mobile: {}
            }
          }
        ],
        label: "NavList"
      })}>
      <ul class={style({
          base: {
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            padding: "0",
            margin: "0"
          },
          tablet: {
            flexDirection: "column",
            alignItems: "flex-start",
            gap: "0",
            width: "100%"
          },
          mobile: {}
        }, __props, { label: "NavLinks" })}>
        <NavLink text="Features" link={{ href: "#features" }} />
        <NavDropdown text="About" isOpen={false}>
          <NavDropdownLink text="Our Story" link={{ href: "#about" }} />
          <NavDropdownLink text="Team" link={{ href: "#team" }} />
          <NavDropdownLink text="Careers" link={{ href: "#careers" }} />
        </NavDropdown>
        <NavLink text="Contact" link={{ href: "#contact" }} />
      </ul>
      <div class={style({ base: {}, tablet: { paddingTop: "8px" }, mobile: {} }, __props)}>
        <Link href="/contact-us" class={style({
            base: {
              display: "inline-flex",
              alignItems: "center",
              justifyContent: "center",
              padding: "var(--b-p)",
              backgroundColor: "var(--accent)",
              color: "var(--white)",
              borderRadius: "var(--b-br)",
              fontSize: "var(--te-fs)",
              letterSpacing: "var(--t-ls)",
              fontWeight: "var(--t-fw)",
              textDecoration: "none",
              transition: "opacity 0.2s"
            },
            tablet: {},
            mobile: {}
          }, __props, {
            interactive: [
              {
                name: "hover",
                prefix: "",
                postfix: ":hover",
                style: { base: { opacity: "0.85" } }
              }
            ]
          })}>Contact</Link>
      </div>
    </div>
  </div>
  <label class={style({
      base: { display: "none", cursor: "pointer" },
      tablet: {
        display: "none",
        position: "fixed",
        top: "0",
        left: "0",
        width: "100%",
        height: "100%",
        backgroundColor: "rgba(0, 0, 0, 0.5)",
        zIndex: "98",
        transition: "opacity 0.3s ease",
        opacity: "0",
        pointerEvents: "none"
      },
      mobile: {}
    }, __props, {
      interactive: [
        {
          prefix: "#menu-toggle:checked ~ ",
          postfix: " ",
          style: {
            base: { opacity: "1", pointerEvents: "auto" },
            tablet: {},
            mobile: {}
          }
        }
      ],
      label: "MobileOverlay"
    })} for="menu-toggle" data-mobile-overlay="" />
</nav>
