---
import { resolveProps, style } from 'meno-astro';
import { Embed } from 'meno-astro/components';

const __props = resolveProps(Astro, {
  text: { type: "string", default: "Dropdown" },
  isOpen: { type: "boolean", default: false }
});
const { text, isOpen, class: className } = __props;
---
<li class={style({ base: { listStyle: "none", position: "relative" } }, __props, { root: true, label: "NavDropdown" })}>
  <button class={style({
      base: {
        color: "var(--text)",
        fontSize: "var(--te-fs)",
        letterSpacing: "var(--t-ls)",
        fontWeight: "var(--t-fw)",
        background: "none",
        border: "none",
        fontFamily: "inherit",
        display: "flex",
        alignItems: "center",
        gap: "6px",
        padding: "24px 12px",
        cursor: "pointer",
        transition: "opacity 0.2s"
      },
      tablet: { padding: "16px 0" },
      mobile: {}
    }, __props, {
      interactive: [
        {
          name: "hover",
          prefix: "",
          postfix: ":hover",
          style: { base: { opacity: "0.7" } }
        }
      ],
      label: "Trigger"
    })} data-el="trigger" aria-expanded="false" aria-haspopup="true">
    <span>{text}</span>
    <Embed html={`<svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`} class={style({
        base: {
          display: "flex",
          alignItems: "center",
          transition: "transform 0.2s ease"
        }
      }, __props, {
        interactive: [
          {
            name: "rotate on open",
            prefix: ".is-open ",
            postfix: "",
            style: { base: { transform: "rotate(180deg)" } }
          }
        ],
        label: "Chevron"
      })} data-el="chevron" />
  </button>
  <div class={style({
      base: {
        display: "none",
        position: "absolute",
        top: "100%",
        left: "-5px",
        minWidth: "200px",
        backgroundColor: "var(--bg)",
        border: "1px solid var(--border)",
        borderRadius: "8px",
        boxShadow: "0 4px 16px rgba(0,0,0,0.08)",
        zIndex: "200",
        padding: "8px 0"
      },
      tablet: {
        position: "static",
        border: "none",
        borderRadius: "0",
        boxShadow: "none",
        padding: "0 0 0 16px",
        minWidth: "unset",
        backgroundColor: "transparent"
      },
      mobile: {}
    }, __props, {
      interactive: [
        {
          name: "show on open",
          prefix: ".is-open ",
          style: { base: { display: "block" } },
          previewProp: "isOpen"
        }
      ],
      label: "Panel"
    })} data-el="panel">
    <ul class={style({
        base: {
          listStyle: "none",
          padding: "0",
          margin: "0",
          display: "flex",
          flexDirection: "column"
        }
      }, __props, { label: "DropdownLinks" })}><slot /></ul>
  </div>
</li>


<script define:vars={{ text, isOpen }}>
(function(el, props){
const trigger = el.querySelector('[data-el="trigger"]');

const open = () => {
  el.classList.add('is-open');
  trigger?.setAttribute('aria-expanded', 'true');
};

const close = () => {
  el.classList.remove('is-open');
  trigger?.setAttribute('aria-expanded', 'false');
};

const toggle = () => {
  if (el.classList.contains('is-open')) {
    close();
  } else {
    const nav = el.closest('nav') || el.closest('ul');
    if (nav) {
      nav.querySelectorAll('.is-open').forEach((sibling) => {
        if (sibling !== el) {
          sibling.classList.remove('is-open');
          const sibTrigger = sibling.querySelector('[data-el="trigger"]');
          sibTrigger?.setAttribute('aria-expanded', 'false');
        }
      });
    }
    open();
  }
};

trigger?.addEventListener('click', (e) => {
  e.preventDefault();
  toggle();
});

el.addEventListener('mouseenter', () => {
  if (window.innerWidth > 1024) {
    open();
  }
});

el.addEventListener('mouseleave', () => {
  if (window.innerWidth > 1024) {
    close();
  }
});

document.addEventListener('click', (e) => {
  if (!el.contains(e.target)) {
    close();
  }
});

document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && el.classList.contains('is-open')) {
    close();
    trigger?.focus();
  }
});

})((function(){var s=document.currentScript,e=s&&s.previousElementSibling;while(e&&(e.nodeName==='STYLE'||e.nodeName==='SCRIPT'))e=e.previousElementSibling;return e||null;})(), { text, isOpen });
</script>