---
import { cx, resolveProps, style } from 'meno-astro';
import { Embed } from 'meno-astro/components';

const __props = resolveProps(Astro, {
  text: { type: "string", default: "Dropdown" },
  isOpen: { type: "boolean", default: false }
});
const { text, isOpen, class: className } = __props;
---
<li class={cx(style({}, __props, { label: "NavDropdown" }), "[list-style:none] relative", className)}>
  <button class={style({}, __props, {
      interactive: [
        {
          name: "hover",
          prefix: "",
          postfix: ":hover",
          style: { base: { opacity: "0.7" } }
        }
      ],
      label: "Trigger"
    }) + " p-[24px_12px] flex items-center gap-1.5 [background:none] text-text border-[none] text-(length:--te-fs) font-(number:--t-fw) font-[inherit] tracking-(--t-ls) cursor-pointer transition-[opacity_0.2s] max-lg:p-[16px_0]"} data-el="trigger" aria-expanded="false" aria-haspopup="true">
    <span>{text}</span>
    <Embed html={`<svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`} class={style({}, __props, {
        interactive: [
          {
            name: "rotate on open",
            prefix: ".is-open ",
            postfix: "",
            style: { base: { transform: "rotate(180deg)" } }
          }
        ],
        label: "Chevron"
      }) + " flex items-center transition-[transform_0.2s_ease]"} data-el="chevron" />
  </button>
  <div class={style({}, __props, {
      interactive: [
        {
          name: "show on open",
          prefix: ".is-open ",
          style: { base: { display: "block" } },
          previewProp: "isOpen"
        }
      ],
      label: "Panel"
    }) + " p-[8px_0] hidden min-w-[200px] bg-bg border-[1px_solid_var(--border)] rounded-[8px] shadow-[0_4px_16px_rgba(0,0,0,0.08)] absolute top-full left-[-5px] z-200 max-lg:p-[0_0_0_16px] max-lg:min-w-[unset] max-lg:bg-transparent max-lg:border-[none] max-lg:rounded-none max-lg:shadow-none max-lg:static"} data-el="panel"><ul class={style({}, __props, { label: "DropdownLinks" }) + " p-[0] m-[0] flex flex-col [list-style:none]"}><slot /></ul></div>
</li>


<script define:vars={{ text, isOpen }}>
(function(el, props){
const trigger = el.querySelector('[data-el="trigger"]');

const open = () => {
  el.classList.add('is-open');
  trigger?.setAttribute('aria-expanded', 'true');
};

const close = () => {
  el.classList.remove('is-open');
  trigger?.setAttribute('aria-expanded', 'false');
};

const toggle = () => {
  if (el.classList.contains('is-open')) {
    close();
  } else {
    const nav = el.closest('nav') || el.closest('ul');
    if (nav) {
      nav.querySelectorAll('.is-open').forEach((sibling) => {
        if (sibling !== el) {
          sibling.classList.remove('is-open');
          const sibTrigger = sibling.querySelector('[data-el="trigger"]');
          sibTrigger?.setAttribute('aria-expanded', 'false');
        }
      });
    }
    open();
  }
};

trigger?.addEventListener('click', (e) => {
  e.preventDefault();
  toggle();
});

el.addEventListener('mouseenter', () => {
  if (window.innerWidth > 1024) {
    open();
  }
});

el.addEventListener('mouseleave', () => {
  if (window.innerWidth > 1024) {
    close();
  }
});

document.addEventListener('click', (e) => {
  if (!el.contains(e.target)) {
    close();
  }
});

document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && el.classList.contains('is-open')) {
    close();
    trigger?.focus();
  }
});

})((function(){var s=document.currentScript,e=s&&s.previousElementSibling;while(e&&(e.nodeName==='STYLE'||e.nodeName==='SCRIPT'))e=e.previousElementSibling;return e||null;})(), { text, isOpen });
</script>