---
import { resolveProps, style } from 'meno-astro';

const __props = resolveProps(Astro, {
  label: { type: "string", default: "I agree to the terms" },
  inputId: { type: "string", default: "checkbox" },
  inputName: { type: "string", default: "checkbox" },
  value: { type: "string", default: "yes" },
  checked: { type: "boolean", default: false },
  required: { type: "boolean", default: false }
});
const {
  label,
  inputId,
  inputName,
  value,
  checked,
  required,
  class: className,
} = __props;
---
<label class={style({
    base: {
      display: "flex",
      flexDirection: "row",
      justifyContent: "flex-start",
      alignItems: "center",
      gap: "10px",
      fontSize: "var(--te-fs)",
      letterSpacing: "var(--t-ls)",
      fontWeight: "500",
      color: "var(--text)",
      cursor: "pointer",
      width: "100%"
    },
    tablet: {},
    mobile: {}
  }, __props, { root: true })} for={inputId || undefined}>
  <input class={style({
      base: {
        width: "18px",
        height: "18px",
        accentColor: "var(--accent)",
        cursor: "pointer",
        margin: "0"
      },
      tablet: {},
      mobile: {}
    }, __props)} type="checkbox" id={inputId || undefined} name={inputName || undefined} value={value || undefined} checked={checked || undefined} required={required || undefined} />
  <span>{label}</span>
</label>
