---
import { cx, resolveProps } from 'meno-astro';

const __props = resolveProps(Astro, {
  label: { type: "string", default: "I agree to the terms" },
  inputId: { type: "string", default: "checkbox" },
  inputName: { type: "string", default: "checkbox" },
  value: { type: "string", default: "yes" },
  checked: { type: "boolean", default: false },
  required: { type: "boolean", default: false }
});
const {
  label,
  inputId,
  inputName,
  value,
  checked,
  required,
  class: className,
} = __props;
---
<label class={cx("flex flex-row justify-start items-center gap-2.5 w-full text-text text-(length:--te-fs) font-[500] tracking-(--t-ls) cursor-pointer", className)} for={inputId || undefined}>
  <input type="checkbox" id={inputId || undefined} name={inputName || undefined} value={value || undefined} checked={checked || undefined} required={required || undefined} class="m-[0] w-[18px] h-[18px] cursor-pointer accent-accent" />
  <span>{label}</span>
</label>
