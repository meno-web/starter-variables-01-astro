---
import { cx, list, resolveProps } from 'meno-astro';

const __props = resolveProps(Astro, {
  label: { type: "string", default: "Choose one" },
  inputName: { type: "string", default: "choice" },
  required: { type: "boolean", default: false },
  options: {
    type: "list",
    itemSchema: {
      label: { type: "string", default: "Option" },
      value: { type: "string", default: "option" }
    },
    default: [
      { label: "Option 1", value: "option-1" },
      { label: "Option 2", value: "option-2" },
      { label: "Option 3", value: "option-3" }
    ]
  }
});
const { label, inputName, required, options, class: className } = __props;
---
<div class={cx("flex flex-col items-stretch gap-2 w-full", className)}>
  <span class="text-text text-(length:--te-fs) font-[500] tracking-(--t-ls)">{label}</span>
  <div class="flex flex-col items-stretch gap-2">
    {list(options).map((option, optionIndex) => (
      <label class="flex flex-row justify-start items-center gap-2.5 text-text text-(length:--te-fs) cursor-pointer">
        <input type="radio" name={inputName || undefined} value={option.value || undefined} required={required || undefined} class="m-[0] w-[18px] h-[18px] cursor-pointer accent-accent" />
        <span>{option.label}</span>
      </label>
    ))}
  </div>
</div>
