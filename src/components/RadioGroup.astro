---
import { list, resolveProps, style } from 'meno-astro';

const __props = resolveProps(Astro, {
  label: { type: "string", default: "Choose one" },
  inputName: { type: "string", default: "choice" },
  required: { type: "boolean", default: false },
  options: {
    type: "list",
    itemSchema: {
      label: { type: "string", default: "Option" },
      value: { type: "string", default: "option" }
    },
    default: [
      { label: "Option 1", value: "option-1" },
      { label: "Option 2", value: "option-2" },
      { label: "Option 3", value: "option-3" }
    ]
  }
});
const { label, inputName, required, options, class: className } = __props;
---
<div class={style({
    base: {
      display: "flex",
      flexDirection: "column",
      alignItems: "stretch",
      gap: "8px",
      width: "100%"
    },
    tablet: {},
    mobile: {}
  }, __props, { root: true })}>
  <span class={style({
      base: {
        fontSize: "var(--te-fs)",
        letterSpacing: "var(--t-ls)",
        fontWeight: "500",
        color: "var(--text)"
      },
      tablet: {},
      mobile: {}
    }, __props)}>{label}</span>
  <div class={style({
      base: {
        display: "flex",
        flexDirection: "column",
        alignItems: "stretch",
        gap: "8px"
      },
      tablet: {},
      mobile: {}
    }, __props)}>
    {list(options).map((option, optionIndex) => (
      <label class={style({
          base: {
            display: "flex",
            flexDirection: "row",
            justifyContent: "flex-start",
            alignItems: "center",
            gap: "10px",
            fontSize: "var(--te-fs)",
            color: "var(--text)",
            cursor: "pointer"
          },
          tablet: {},
          mobile: {}
        }, __props)}>
        <input class={style({
            base: {
              width: "18px",
              height: "18px",
              accentColor: "var(--accent)",
              cursor: "pointer",
              margin: "0"
            },
            tablet: {},
            mobile: {}
          }, __props)} type="radio" name={inputName || undefined} value={option.value || undefined} required={required || undefined} />
        <span>{option.label}</span>
      </label>
    ))}
  </div>
</div>
