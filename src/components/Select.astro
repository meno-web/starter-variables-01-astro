---
import { cx, list, resolveProps } from 'meno-astro';

const __props = resolveProps(Astro, {
  label: { type: "string", default: "Select" },
  inputId: { type: "string", default: "select" },
  inputName: { type: "string", default: "select" },
  required: { type: "boolean", default: false },
  options: {
    type: "list",
    itemSchema: {
      label: { type: "string", default: "Option" },
      value: { type: "string", default: "option" }
    },
    default: [
      { label: "Select an option", value: "" },
      { label: "Option 1", value: "option-1" },
      { label: "Option 2", value: "option-2" }
    ]
  }
});
const {
  label,
  inputId,
  inputName,
  required,
  options,
  class: className,
} = __props;
---
<div class={cx("flex flex-col items-stretch gap-2 w-full", className)}>
  <label for={inputId || undefined} class="text-text text-(length:--te-fs) font-[500] tracking-(--t-ls)">{label}</label>
  <select id={inputId || undefined} name={inputName || undefined} required={required || undefined} class="p-[12px_16px] w-full bg-bg text-text border-[1px_solid] rounded-(--b-br) border-border text-(length:--te-fs) outline-none cursor-pointer [appearance:none]">
    {list(options).map((option, optionIndex) => (
      <option value={option.value || undefined}>{option.label}</option>
    ))}
  </select>
</div>
