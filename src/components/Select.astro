---
import { list, resolveProps, style } from 'meno-astro';

const __props = resolveProps(Astro, {
  label: { type: "string", default: "Select" },
  inputId: { type: "string", default: "select" },
  inputName: { type: "string", default: "select" },
  required: { type: "boolean", default: false },
  options: {
    type: "list",
    itemSchema: {
      label: { type: "string", default: "Option" },
      value: { type: "string", default: "option" }
    },
    default: [
      { label: "Select an option", value: "" },
      { label: "Option 1", value: "option-1" },
      { label: "Option 2", value: "option-2" }
    ]
  }
});
const {
  label,
  inputId,
  inputName,
  required,
  options,
  class: className,
} = __props;
---
<div class={style({
    base: {
      display: "flex",
      flexDirection: "column",
      alignItems: "stretch",
      gap: "8px",
      width: "100%"
    },
    tablet: {},
    mobile: {}
  }, __props, { root: true })}>
  <label class={style({
      base: {
        fontSize: "var(--te-fs)",
        letterSpacing: "var(--t-ls)",
        fontWeight: "500",
        color: "var(--text)"
      },
      tablet: {},
      mobile: {}
    }, __props)} for={inputId || undefined}>{label}</label>
  <select class={style({
      base: {
        padding: "12px 16px",
        fontSize: "var(--te-fs)",
        color: "var(--text)",
        backgroundColor: "var(--bg)",
        border: "1px solid",
        borderRadius: "var(--b-br)",
        outline: "none",
        width: "100%",
        borderColor: "var(--border)",
        cursor: "pointer",
        appearance: "none"
      },
      tablet: {},
      mobile: {}
    }, __props)} id={inputId || undefined} name={inputName || undefined} required={required || undefined}>
    {list(options).map((option, optionIndex) => (
      <option value={option.value || undefined}>{option.label}</option>
    ))}
  </select>
</div>
