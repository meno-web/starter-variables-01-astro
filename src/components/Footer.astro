        <Link href="#terms" class={style({
            base: {
              fontSize: "14px",
              letterSpacing: "var(--t-ls)",
              fontWeight: "var(--t-fw)",
              color: "var(--muted)",
              textDecoration: "none",
              transition: "color 0.2s"
            }
          }, __props, {
            interactive: [
              {
                name: "hover",
                prefix: "",
                postfix: ":hover",
                style: { base: { color: "var(--text)" } }
