---
import { resolveProps, style } from 'meno-astro';
import { Link } from 'meno-astro/components';

const __props = resolveProps(Astro, {});
const { class: className } = __props;
---
<footer class={style({
    base: {
      padding: "var(--s-p)",
      backgroundColor: "var(--bg)",
      borderTop: "1px solid var(--border)"
    },
    tablet: {},
    mobile: {}
  }, __props, { root: true, label: "Footer" })}>
  <div class={style({
      base: { display: "block", maxWidth: "var(--c-s)", margin: "auto" },
      tablet: {},
      mobile: {}
    }, __props, { label: "Container" })}>
    <div class={style({
        base: {
          display: "grid",
          gridTemplateColumns: "2fr 1fr 1fr 1fr",
          gap: "40px"
        },
        tablet: { gridTemplateColumns: "1fr 1fr" },
        mobile: { gridTemplateColumns: "1fr" }
      }, __props, { label: "TopRow" })}>
      <div class={style({}, __props, { label: "Brand" })}>
        <span class={style({
            base: {
              display: "block",
              fontSize: "22px",
              fontWeight: "var(--h-fw)",
              letterSpacing: "var(--h-ls)",
              color: "var(--text)",
              marginBottom: "12px"
            },
            tablet: {},
            mobile: {}
          }, __props)}>Starter</span>
        <p class={style({
            base: {
              fontSize: "var(--t-fs)",
              letterSpacing: "var(--t-ls)",
              fontWeight: "var(--t-fw)",
              lineHeight: "var(--t-lh)",
              color: "var(--muted)",
              maxWidth: "320px",
              margin: "0"
            },
            tablet: {},
            mobile: {}
          }, __props)}>Short tagline that previews how this footer copy reads in the editor.</p>
      </div>
      <div class={style({}, __props, { label: "Column1" })}>
        <span class={style({
            base: {
              display: "block",
              fontSize: "var(--s-fs)",
              letterSpacing: "var(--s-ls)",
              fontWeight: "var(--s-fw)",
              textTransform: "var(--subtitle)",
              color: "var(--text)",
              marginBottom: "16px"
            },
            tablet: {},
            mobile: {}
          }, __props)}>Product</span>
        <ul class={style({
            base: {
              listStyle: "none",
              display: "flex",
              flexDirection: "column",
              gap: "10px",
              padding: "0",
              margin: "0"
            }
          }, __props)}>
          <li>
            <Link href="#features" class={style({
                base: {
                  color: "var(--muted)",
                  fontSize: "var(--t-fs)",
                  letterSpacing: "var(--t-ls)",
                  fontWeight: "var(--t-fw)",
                  textDecoration: "none",
                  transition: "color 0.2s"
                }
              }, __props, {
                interactive: [
                  {
                    name: "hover",
                    prefix: "",
                    postfix: ":hover",
                    style: { base: { color: "var(--text)" } }
                  }
                ]
              })}>Features</Link>
          </li>
          <li>
            <Link href="#pricing" class={style({
                base: {
                  color: "var(--muted)",
                  fontSize: "var(--t-fs)",
                  letterSpacing: "var(--t-ls)",
                  fontWeight: "var(--t-fw)",
                  textDecoration: "none",
                  transition: "color 0.2s"
                }
              }, __props, {
                interactive: [
                  {
                    name: "hover",
                    prefix: "",
                    postfix: ":hover",
                    style: { base: { color: "var(--text)" } }
                  }
                ]
              })}>Pricing</Link>
          </li>
          <li>
            <Link href="#integrations" class={style({
                base: {
                  color: "var(--muted)",
                  fontSize: "var(--t-fs)",
                  letterSpacing: "var(--t-ls)",
                  fontWeight: "var(--t-fw)",
                  textDecoration: "none",
                  transition: "color 0.2s"
                }
              }, __props, {
                interactive: [
                  {
                    name: "hover",
                    prefix: "",
                    postfix: ":hover",
                    style: { base: { color: "var(--text)" } }
                  }
                ]
              })}>Integrations</Link>
          </li>
        </ul>
      </div>
      <div class={style({}, __props, { label: "Column2" })}>
        <span class={style({
            base: {
              display: "block",
              fontSize: "var(--s-fs)",
              letterSpacing: "var(--s-ls)",
              fontWeight: "var(--s-fw)",
              textTransform: "var(--subtitle)",
              color: "var(--text)",
              marginBottom: "16px"
            },
            tablet: {},
            mobile: {}
          }, __props)}>Company</span>
        <ul class={style({
