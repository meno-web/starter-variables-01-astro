                }
              }, __props, {
                interactive: [
                  {
                    name: "hover",
                    prefix: "",
                    postfix: ":hover",
                    style: { base: { color: "var(--text)" } }
                  }
                ]
              })}>About</Link>
          </li>
          <li>
            <Link href="/blog" class={style({
                base: {
                  color: "var(--muted)",
                  fontSize: "var(--t-fs)",
                  letterSpacing: "var(--t-ls)",
                  fontWeight: "var(--t-fw)",
                  textDecoration: "none",
                  transition: "color 0.2s"
                }
              }, __props, {
                interactive: [
                  {
                    name: "hover",
                    prefix: "",
                    postfix: ":hover",
                    style: { base: { color: "var(--text)" } }
                  }
                ]
              })}>Blog</Link>
          </li>
          <li>
            <Link href="#careers" class={style({
                base: {
                  color: "var(--muted)",
                  fontSize: "var(--t-fs)",
                  letterSpacing: "var(--t-ls)",
                  fontWeight: "var(--t-fw)",
                  textDecoration: "none",
                  transition: "color 0.2s"
                }
