---
import { cx, resolveProps, style } from 'meno-astro';
import { Link } from 'meno-astro/components';

const __props = resolveProps(Astro, {});
const { class: className } = __props;
---
<footer class={cx(style({}, __props, { label: "Footer" }), "p-(--s-p) bg-bg border-t-[1px_solid_var(--border)]", className)}>
  <div class={style({}, __props, { label: "Container" }) + " m-auto block max-w-(--c-s)"}>
    <div class={style({}, __props, { label: "TopRow" }) + " grid gap-10 grid-cols-[2fr_1fr_1fr_1fr] max-lg:grid-cols-[1fr_1fr] max-sm:grid-cols-[1fr]"}>
      <div class={style({}, __props, { label: "Brand" })}>
        <span class="mb-3 block text-text text-[22px] font-(number:--h-fw) tracking-(--h-ls)">Starter</span>
        <p class="m-[0] max-w-80 text-muted text-(length:--t-fs) font-(number:--t-fw) leading-(--t-lh) tracking-(--t-ls)">Short tagline that previews how this footer copy reads in the editor.</p>
      </div>
      <div class={style({}, __props, { label: "Column1" })}>
        <span class="mb-4 block text-text text-(length:--s-fs) font-(number:--s-fw) [text-transform:var(--subtitle)] tracking-(--s-ls)">Product</span>
        <ul class="p-[0] m-[0] flex flex-col gap-2.5 [list-style:none]">
          <li>
            <Link href="#features" class={style({}, __props, {
                interactive: [
                  {
                    name: "hover",
                    prefix: "",
                    postfix: ":hover",
                    style: { base: { color: "var(--text)" } }
                  }
                ]
              }) + " text-muted text-(length:--t-fs) font-(number:--t-fw) no-underline tracking-(--t-ls) transition-[color_0.2s]"}>Features</Link>
          </li>
          <li>
            <Link href="#pricing" class={style({}, __props, {
                interactive: [
                  {
                    name: "hover",
                    prefix: "",
                    postfix: ":hover",
                    style: { base: { color: "var(--text)" } }
                  }
                ]
              }) + " text-muted text-(length:--t-fs) font-(number:--t-fw) no-underline tracking-(--t-ls) transition-[color_0.2s]"}>Pricing</Link>
          </li>
          <li>
            <Link href="#integrations" class={style({}, __props, {
                interactive: [
                  {
                    name: "hover",
                    prefix: "",
                    postfix: ":hover",
                    style: { base: { color: "var(--text)" } }
                  }
                ]
              }) + " text-muted text-(length:--t-fs) font-(number:--t-fw) no-underline tracking-(--t-ls) transition-[color_0.2s]"}>Integrations</Link>
          </li>
        </ul>
      </div>
      <div class={style({}, __props, { label: "Column2" })}>
        <span class="mb-4 block text-text text-(length:--s-fs) font-(number:--s-fw) [text-transform:var(--subtitle)] tracking-(--s-ls)">Company</span>
        <ul class="p-[0] m-[0] flex flex-col gap-2.5 [list-style:none]">
          <li>
            <Link href="#about" class={style({}, __props, {
                interactive: [
                  {
                    name: "hover",
                    prefix: "",
                    postfix: ":hover",
                    style: { base: { color: "var(--text)" } }
                  }
                ]
              }) + " text-muted text-(length:--t-fs) font-(number:--t-fw) no-underline tracking-(--t-ls) transition-[color_0.2s]"}>About</Link>
          </li>
          <li>
            <Link href="/blog" class={style({}, __props, {
                interactive: [
                  {
                    name: "hover",
                    prefix: "",
                    postfix: ":hover",
                    style: { base: { color: "var(--text)" } }
                  }
                ]
              }) + " text-muted text-(length:--t-fs) font-(number:--t-fw) no-underline tracking-(--t-ls) transition-[color_0.2s]"}>Blog</Link>
          </li>
          <li>
            <Link href="#careers" class={style({}, __props, {
                interactive: [
                  {
                    name: "hover",
                    prefix: "",
                    postfix: ":hover",
                    style: { base: { color: "var(--text)" } }
                  }
                ]
              }) + " text-muted text-(length:--t-fs) font-(number:--t-fw) no-underline tracking-(--t-ls) transition-[color_0.2s]"}>Careers</Link>
          </li>
        </ul>
      </div>
      <div class={style({}, __props, { label: "Column3" })}>
        <span class="mb-4 block text-text text-(length:--s-fs) font-(number:--s-fw) [text-transform:var(--subtitle)] tracking-(--s-ls)">Support</span>
        <ul class="p-[0] m-[0] flex flex-col gap-2.5 [list-style:none]">
          <li>
            <Link href="#help" class={style({}, __props, {
                interactive: [
                  {
                    name: "hover",
                    prefix: "",
                    postfix: ":hover",
                    style: { base: { color: "var(--text)" } }
                  }
                ]
              }) + " text-muted text-(length:--t-fs) font-(number:--t-fw) no-underline tracking-(--t-ls) transition-[color_0.2s]"}>Help Center</Link>
          </li>
          <li>
            <Link href="#contact" class={style({}, __props, {
                interactive: [
                  {
                    name: "hover",
                    prefix: "",
                    postfix: ":hover",
                    style: { base: { color: "var(--text)" } }
                  }
                ]
              }) + " text-muted text-(length:--t-fs) font-(number:--t-fw) no-underline tracking-(--t-ls) transition-[color_0.2s]"}>Contact</Link>
          </li>
          <li>
            <Link href="#status" class={style({}, __props, {
                interactive: [
                  {
                    name: "hover",
                    prefix: "",
                    postfix: ":hover",
                    style: { base: { color: "var(--text)" } }
                  }
                ]
              }) + " text-muted text-(length:--t-fs) font-(number:--t-fw) no-underline tracking-(--t-ls) transition-[color_0.2s]"}>Status</Link>
          </li>
        </ul>
      </div>
    </div>
    <div class={style({}, __props, { label: "BottomRow" }) + " pt-6 mt-12 flex justify-between items-center border-t-[1px_solid_var(--border)] max-sm:flex-col max-sm:gap-4 max-sm:text-center"}>
      <span class="text-muted text-[14px] font-(number:--t-fw) tracking-(--t-ls)">© 2026 Starter. All rights reserved.</span>
      <div class="flex gap-6">
        <Link href="#privacy" class={style({}, __props, {
            interactive: [
              {
                name: "hover",
                prefix: "",
                postfix: ":hover",
                style: { base: { color: "var(--text)" } }
              }
            ]
          }) + " text-muted text-[14px] font-(number:--t-fw) no-underline tracking-(--t-ls) transition-[color_0.2s]"}>Privacy policy</Link>
        <Link href="#terms" class={style({}, __props, {
            interactive: [
              {
                name: "hover",
                prefix: "",
                postfix: ":hover",
                style: { base: { color: "var(--text)" } }
              }
            ]
          }) + " text-muted text-[14px] font-(number:--t-fw) no-underline tracking-(--t-ls) transition-[color_0.2s]"}>Terms of Service</Link>
      </div>
    </div>
  </div>
</footer>
