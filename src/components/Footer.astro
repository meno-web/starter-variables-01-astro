                interactive: [
                  {
                    name: "hover",
                    prefix: "",
                    postfix: ":hover",
                    style: { base: { color: "var(--text)" } }
                  }
                ]
              })}>Careers</Link>
          </li>
        </ul>
      </div>
      <div class={style({}, __props, { label: "Column3" })}>
        <span class={style({
            base: {
              display: "block",
              fontSize: "var(--s-fs)",
              letterSpacing: "var(--s-ls)",
              fontWeight: "var(--s-fw)",
              textTransform: "var(--subtitle)",
              color: "var(--text)",
              marginBottom: "16px"
            },
            tablet: {},
