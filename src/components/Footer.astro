                }
              }, __props, {
                interactive: [
                  {
                    name: "hover",
                    prefix: "",
                    postfix: ":hover",
                    style: { base: { color: "var(--text)" } }
                  }
                ]
              })}>Status</Link>
          </li>
        </ul>
      </div>
    </div>
    <div class={style({
        base: {
          borderTop: "1px solid var(--border)",
          marginTop: "48px",
          paddingTop: "24px",
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center"
        },
        tablet: {},
        mobile: { flexDirection: "column", gap: "16px", textAlign: "center" }
      }, __props, { label: "BottomRow" })}>
      <span class={style({
          base: {
            fontSize: "14px",
            letterSpacing: "var(--t-ls)",
            fontWeight: "var(--t-fw)",
            color: "var(--muted)"
          },
          tablet: {},
          mobile: {}
        }, __props)}>© 2026 Starter. All rights reserved.</span>
      <div class={style({ base: { display: "flex", gap: "24px" } }, __props)}>
        <Link href="#privacy" class={style({
            base: {
              fontSize: "14px",
              letterSpacing: "var(--t-ls)",
              fontWeight: "var(--t-fw)",
              color: "var(--muted)",
              textDecoration: "none",
              transition: "color 0.2s"
            }
          }, __props, {
            interactive: [
              {
                name: "hover",
                prefix: "",
                postfix: ":hover",
                style: { base: { color: "var(--text)" } }
              }
            ]
