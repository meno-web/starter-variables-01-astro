---
import { cx, resolveProps } from 'meno-astro';

const __props = resolveProps(Astro, {
  label: { type: "string", default: "Label" },
  inputId: { type: "string", default: "field" },
  inputName: { type: "string", default: "field" },
  inputType: {
    type: "select",
    options: ["text", "email", "tel", "url", "password", "number"],
    default: "text"
  },
  placeholder: { type: "string", default: "Type here..." },
  required: { type: "boolean", default: false }
});
const {
  label,
  inputId,
  inputName,
  inputType,
  placeholder,
  required,
  class: className,
} = __props;
---
<div class={cx("flex flex-col items-stretch gap-2 w-full", className)}>
  <label for={inputId || undefined} class="text-text text-(length:--te-fs) font-[500] tracking-(--t-ls)">{label}</label>
  <input type={inputType || undefined} id={inputId || undefined} name={inputName || undefined} placeholder={placeholder || undefined} required={required || undefined} class="p-[12px_16px] w-full bg-bg text-text border-[1px_solid] rounded-(--b-br) border-border text-(length:--te-fs) outline-none" />
</div>
