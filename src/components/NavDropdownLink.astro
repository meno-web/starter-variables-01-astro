---
import { cx, resolveProps, style } from 'meno-astro';
import { Link } from 'meno-astro/components';

const __props = resolveProps(Astro, {
  text: { type: "string", default: "Link" },
  link: { type: "link" }
});
const { text, link, class: className } = __props;
---
<li class={cx("[list-style:none]", className)}>
  <Link href={link} class={style({}, __props, {
      interactive: [
        {
          name: "hover",
          prefix: "",
          postfix: ":hover",
          style: {
            base: { backgroundColor: "var(--gray-100)" },
            tablet: { backgroundColor: "transparent", opacity: "0.7" }
          }
        }
      ]
    }) + " p-[10px_16px] block text-text text-(length:--t-fs) font-(number:--t-fw) no-underline tracking-(--t-ls) cursor-pointer transition-[background_0.2s] max-lg:p-[8px_0]"}>{text}</Link>
</li>
