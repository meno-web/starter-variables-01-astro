---
import { cx, resolveProps } from 'meno-astro';

const __props = resolveProps(Astro, {});
const { class: className } = __props;
---
<div class={cx("min-h-screen bg-bg text-text", className)}><slot /></div>


<style is:global>
h1 .custom-span, 
h2 .custom-span, 
h3 .custom-span, 
h4 .custom-span, 
h5 .custom-span {
  color: var(--span);
}
</style>