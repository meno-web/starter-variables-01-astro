---
import { resolveProps, style } from 'meno-astro';
import { Link } from 'meno-astro/components';

const __props = resolveProps(Astro, {
  text: { type: "string", default: "Link" },
  link: { type: "link" }
});
const { text, link, class: className } = __props;
---
<li class={style({ base: { listStyle: "none" } }, __props, { root: true })}>
  <Link href={link} class={style({
      base: {
        color: "var(--text)",
        fontSize: "var(--te-fs)",
        letterSpacing: "var(--t-ls)",
        fontWeight: "var(--t-fw)",
        textDecoration: "none",
        display: "block",
        padding: "24px 12px",
        transition: "opacity 0.2s",
        cursor: "pointer"
      },
      tablet: { padding: "16px 0" },
      mobile: {}
    }, __props, {
      interactive: [
        {
          name: "hover",
          prefix: "",
          postfix: ":hover",
          style: { base: { opacity: "0.7" } }
        }
      ]
    })}>{text}</Link>
</li>
