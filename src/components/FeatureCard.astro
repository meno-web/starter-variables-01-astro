---
import { cx, resolveProps } from 'meno-astro';

const __props = resolveProps(Astro, {
  text: { type: "string", default: "This is heading" },
  description: { type: "string", default: "This is heading" }
});
const { text, description, class: className } = __props;
---
<div class={cx("p-6 bg-bg rounded-[8px]", className)}>
  <h3 class="mb-(--he-m) text-text text-(length:--hea-fs) font-(number:--h-fw) leading-(--h-lh) tracking-(--h-ls)">{text}</h3>
  <p class="text-text text-(length:--t-fs) font-(number:--t-fw) leading-(--t-lh) tracking-(--t-ls)">{description}</p>
</div>
