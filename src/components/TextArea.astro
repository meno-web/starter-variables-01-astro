---
import { resolveProps, style } from 'meno-astro';

const __props = resolveProps(Astro, {
  label: { type: "string", default: "Label" },
  inputId: { type: "string", default: "message" },
  inputName: { type: "string", default: "message" },
  placeholder: { type: "string", default: "Type here..." },
  rows: { type: "number", default: 6 },
  required: { type: "boolean", default: false }
});
const {
  label,
  inputId,
  inputName,
  placeholder,
  rows,
  required,
  class: className,
} = __props;
---
<div class={style({
    base: {
      display: "flex",
      flexDirection: "column",
      alignItems: "stretch",
      gap: "8px",
      width: "100%"
    },
    tablet: {},
    mobile: {}
  }, __props, { root: true })}>
  <label class={style({
      base: {
        fontSize: "var(--te-fs)",
        letterSpacing: "var(--t-ls)",
        fontWeight: "500",
        color: "var(--text)"
      },
      tablet: {},
      mobile: {}
    }, __props)} for={inputId || undefined}>{label}</label>
  <textarea class={style({
      base: {
        padding: "12px 16px",
        fontSize: "var(--te-fs)",
        color: "var(--text)",
        backgroundColor: "var(--bg)",
        border: "1px solid",
        borderRadius: "var(--b-br)",
        outline: "none",
        width: "100%",
        resize: "vertical",
        fontFamily: "inherit",
        lineHeight: "var(--t-lh)",
        borderColor: "var(--border)"
      },
      tablet: {},
      mobile: {}
    }, __props)} id={inputId || undefined} name={inputName || undefined} placeholder={placeholder || undefined} rows={rows || undefined} required={required || undefined} />
</div>
