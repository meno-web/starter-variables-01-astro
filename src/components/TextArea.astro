---
import { cx, resolveProps } from 'meno-astro';

const __props = resolveProps(Astro, {
  label: { type: "string", default: "Label" },
  inputId: { type: "string", default: "message" },
  inputName: { type: "string", default: "message" },
  placeholder: { type: "string", default: "Type here..." },
  rows: { type: "number", default: 6 },
  required: { type: "boolean", default: false }
});
const {
  label,
  inputId,
  inputName,
  placeholder,
  rows,
  required,
  class: className,
} = __props;
---
<div class={cx("flex flex-col items-stretch gap-2 w-full", className)}>
  <label for={inputId || undefined} class="text-text text-(length:--te-fs) font-[500] tracking-(--t-ls)">{label}</label>
  <textarea id={inputId || undefined} name={inputName || undefined} placeholder={placeholder || undefined} rows={rows || undefined} required={required || undefined} class="p-[12px_16px] w-full bg-bg text-text border-[1px_solid] rounded-(--b-br) border-border text-(length:--te-fs) font-[inherit] leading-(--t-lh) outline-none resize-y" />
</div>
