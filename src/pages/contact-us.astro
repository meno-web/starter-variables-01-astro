---
import { style } from 'meno-astro';
import { BaseLayout } from 'meno-astro/components';
import Checkbox from '../components/Checkbox.astro';
import Footer from '../components/Footer.astro';
import Input from '../components/Input.astro';
import Layout from '../components/Layout.astro';
import Navigation from '../components/Navigation.astro';
import RadioGroup from '../components/RadioGroup.astro';
import Select from '../components/Select.astro';
import TextArea from '../components/TextArea.astro';
import '../styles/theme.css';

const meta = {
  title: "Contact Us",
  description: "Get in touch with our team. Send us a message and we will get back to you shortly."
};
---
<BaseLayout meta={meta}>
  <Layout>
    <Navigation />
    <section class={style({
        base: { padding: "var(--s-p)", backgroundColor: "var(--bg)" },
        tablet: {},
        mobile: {}
      })}>
      <container class={style({
          base: { display: "block", maxWidth: "640px", margin: "auto" },
          tablet: {},
          mobile: {}
        })}>
        <div class={style({
            base: {
              display: "flex",
              flexDirection: "column",
              justifyContent: "flex-start",
              alignItems: "center",
              textAlign: "center",
              marginBottom: "52px"
            },
            tablet: {},
            mobile: {}
          })}>
          <h1 class={style({
              base: {
                fontSize: "var(--he-fs)",
                letterSpacing: "var(--h-ls)",
                fontWeight: "var(--h-fw)",
                marginBottom: "var(--h-m)",
                lineHeight: "var(--h-lh)",
                color: "var(--text)",
                textAlign: "center"
              },
              tablet: {},
              mobile: {}
            })}><Fragment set:html={`<!--MENO_RAW_HTML-->Get in <span class="custom-span">touch</span>`} /></h1>
          <p class={style({
              base: {
                fontSize: "var(--t-fs)",
                letterSpacing: "var(--t-ls)",
                fontWeight: "var(--t-fw)",
                lineHeight: "var(--t-lh)",
                color: "var(--text)",
                textAlign: "center",
                maxWidth: "500px"
              },
              tablet: {},
              mobile: {}
            })}>Have a question or want to work together? Send us a message and we will get back to you shortly.</p>
        </div>
        <form class={style({
            base: {
              display: "flex",
              flexDirection: "column",
              justifyContent: "flex-start",
              alignItems: "stretch",
              gap: "20px"
            },
            tablet: {},
            mobile: {}
          })} action="/api/send-email" method="post">
          <Input label="Name" inputId="name" inputName="name" inputType="text" placeholder="John Doe" required={true} />
          <Input label="Email" inputId="email" inputName="email" inputType="email" placeholder="johndoe@email.com" required={true} />
          <Input label="Phone" inputId="phone" inputName="phone" inputType="tel" placeholder="0 000 000 000" required={false} />
          <Select label="Subject" inputId="subject" inputName="subject" required={true} options={[
              { label: "Select a subject", value: "" },
              { label: "General inquiry", value: "general" },
              { label: "Support", value: "support" },
              { label: "Partnership", value: "partnership" },
              { label: "Other", value: "other" }
            ]} />
          <RadioGroup label="Preferred contact method" inputName="contactMethod" required={true} options={[{ label: "Email", value: "email" }, { label: "Phone", value: "phone" }]} />
          <TextArea label="Message" inputId="message" inputName="message" placeholder="Message" rows={6} required={true} />
          <Checkbox label="Subscribe to our newsletter" inputId="newsletter" inputName="newsletter" value="yes" checked={false} required={false} />
          <Checkbox label="I agree to the privacy policy" inputId="privacy" inputName="privacy" value="yes" checked={false} required={true} />
          <button class={style({
              base: {
                padding: "var(--b-p)",
                display: "inline-flex",
                flexDirection: "row",
                justifyContent: "center",
                alignItems: "center",
                backgroundColor: "var(--accent)",
                borderRadius: "var(--b-br)",
                color: "var(--white)",
                fontSize: "var(--te-fs)",
                fontWeight: "500",
                border: "none",
                cursor: "pointer",
                marginTop: "var(--b-m)"
              },
              tablet: {},
              mobile: {}
            })} type="submit">Send Message</button>
        </form>
      </container>
    </section>
    <Footer />
  </Layout>
</BaseLayout>
