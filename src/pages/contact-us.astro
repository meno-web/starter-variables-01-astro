---
import { BaseLayout } from 'meno-astro/components';
import Checkbox from '../components/Checkbox.astro';
import Footer from '../components/Footer.astro';
import Input from '../components/Input.astro';
import Layout from '../components/Layout.astro';
import Navigation from '../components/Navigation.astro';
import RadioGroup from '../components/RadioGroup.astro';
import Select from '../components/Select.astro';
import TextArea from '../components/TextArea.astro';
import '../styles/theme.css';

const meta = {
  title: "Contact Us",
  description: "Get in touch with our team. Send us a message and we will get back to you shortly."
};
---
<BaseLayout meta={meta}>
  <Layout>
    <Navigation />
    <section class="p-(--s-p) bg-bg">
      <container class="m-auto block max-w-[640px]">
        <div class="mb-[52px] flex flex-col justify-start items-center text-center">
          <h1 class="mb-(--h-m) text-text text-(length:--he-fs) font-(number:--h-fw) text-center leading-(--h-lh) tracking-(--h-ls)"><Fragment set:html={`Get in <span class="custom-span">touch</span>`} /></h1>
          <p class="max-w-[500px] text-text text-(length:--t-fs) font-(number:--t-fw) text-center leading-(--t-lh) tracking-(--t-ls)">Have a question or want to work together? Send us a message and we will get back to you shortly.</p>
        </div>
        <form action="/api/send-email" method="post" class="flex flex-col justify-start items-stretch gap-5">
          <Input label="Name" inputId="name" inputName="name" inputType="text" placeholder="John Doe" required={true} />
          <Input label="Email" inputId="email" inputName="email" inputType="email" placeholder="johndoe@email.com" required={true} />
          <Input label="Phone" inputId="phone" inputName="phone" inputType="tel" placeholder="0 000 000 000" required={false} />
          <Select label="Subject" inputId="subject" inputName="subject" required={true} options={[
              { label: "Select a subject", value: "" },
              { label: "General inquiry", value: "general" },
              { label: "Support", value: "support" },
              { label: "Partnership", value: "partnership" },
              { label: "Other", value: "other" }
            ]} />
          <RadioGroup label="Preferred contact method" inputName="contactMethod" required={true} options={[{ label: "Email", value: "email" }, { label: "Phone", value: "phone" }]} />
          <TextArea label="Message" inputId="message" inputName="message" placeholder="Message" rows={6} required={true} />
          <Checkbox label="Subscribe to our newsletter" inputId="newsletter" inputName="newsletter" value="yes" checked={false} required={false} />
          <Checkbox label="I agree to the privacy policy" inputId="privacy" inputName="privacy" value="yes" checked={false} required={true} />
          <button type="submit" class="p-(--b-p) mt-(--b-m) inline-flex flex-row justify-center items-center bg-accent text-[var(--white)] border-[none] rounded-(--b-br) text-(length:--te-fs) font-[500] cursor-pointer">Send Message</button>
        </form>
      </container>
    </section>
    <Footer />
  </Layout>
</BaseLayout>
