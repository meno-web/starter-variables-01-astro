---
import { getCollection } from 'astro:content';
import { getCollectionList, i18n, style } from 'meno-astro';
import { BaseLayout, Link } from 'meno-astro/components';
import Footer from '../components/Footer.astro';
import Layout from '../components/Layout.astro';
import Navigation from '../components/Navigation.astro';
import '../styles/theme.css';

const meta = { title: "Blog", description: "Browse all articles, tutorials, and insights." };

const blogList = await getCollectionList("blog", { sort: { field: "_createdAt", order: "desc" } }, Astro, getCollection);
---
<BaseLayout meta={meta}>
  <Layout>
    <Navigation />
    <section class={style({
        base: { padding: "var(--s-p)", backgroundColor: "var(--bg)" },
        tablet: {},
        mobile: {}
      })}>
      <container class={style({
          base: { display: "block", maxWidth: "var(--c-s)", margin: "auto" },
          tablet: {},
          mobile: {}
        })}>
        <div class={style({
            base: {
              display: "flex",
              flexDirection: "column",
              justifyContent: "flex-start",
              alignItems: "center",
              textAlign: "center",
              marginBottom: "52px"
            },
            tablet: {},
            mobile: {}
          })}>
          <span class={style({
              base: {
                fontSize: "var(--s-fs)",
                letterSpacing: "var(--s-ls)",
                fontWeight: "var(--s-fw)",
                color: "var(--text)",
                textTransform: "var(--subtitle)",
                marginBottom: "var(--s-m)"
              },
              tablet: {},
              mobile: {}
            })}>Blog</span>
          <h1 class={style({
              base: {
                fontSize: "var(--h-fs)",
                letterSpacing: "var(--h-ls)",
                fontWeight: "var(--h-fw)",
                marginBottom: "var(--h-m)",
                lineHeight: "var(--h-lh)",
                color: "var(--text)",
                textAlign: "center"
              },
              tablet: {},
              mobile: {}
            })}>All articles</h1>
          <p class={style({
              base: {
                fontSize: "var(--t-fs)",
                letterSpacing: "var(--t-ls)",
                fontWeight: "var(--t-fw)",
                lineHeight: "var(--t-lh)",
                color: "var(--text)",
                textAlign: "center",
                maxWidth: "520px"
              },
              tablet: {},
              mobile: {}
            })}>Browse every post, tutorial, and insight we've published.</p>
        </div>
        <div class={style({
            base: { display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: "16px" },
            tablet: {},
            mobile: {}
          })}>
          {blogList.map((post, postIndex) => (
            <Link href={i18n(post._url)} class={style({
                base: {
                  display: "flex",
                  flexDirection: "column",
                  justifyContent: "flex-start",
                  alignItems: "stretch",
                  backgroundColor: "var(--bg)",
                  borderRadius: "8px",
                  overflow: "hidden",
                  border: "1px solid",
                  borderColor: "var(--border)",
                  color: "var(--text)",
                  textDecoration: "none"
                },
                tablet: {},
                mobile: {}
              })}>
              <img class={style({
                  base: { aspectRatio: "16 / 10", objectFit: "cover" },
                  tablet: {},
                  mobile: {}
                })} src={i18n(post.image) || undefined} alt={i18n(post.title) || undefined} />
              <div class={style({
                  base: {
                    padding: "24px",
                    display: "flex",
                    flexDirection: "column",
                    alignItems: "flex-start",
                    gap: "12px"
                  },
                  tablet: {},
                  mobile: {}
                })}>
                <span class={style({
                    base: {
                      display: "inline-block",
                      padding: "4px 12px",
                      backgroundColor: "var(--gray-100)",
                      borderRadius: "999px",
                      fontSize: "var(--tex-fs)",
                      fontWeight: "500",
                      color: "var(--text)"
                    },
                    tablet: {},
                    mobile: {}
                  })}>{i18n(post.category)}</span>
                <h3 class={style({
                    base: {
                      fontSize: "var(--head-fs)",
                      letterSpacing: "var(--h-ls)",
                      fontWeight: "var(--h-fw)",
                      lineHeight: "var(--h-lh)",
                      color: "var(--text)",
                      margin: "0"
                    },
                    tablet: {},
                    mobile: {}
                  })}>{i18n(post.title)}</h3>
                <span class={style({
                    base: {
                      fontSize: "var(--te-fs)",
                      letterSpacing: "var(--t-ls)",
                      fontWeight: "var(--t-fw)",
                      color: "var(--muted)"
                    },
                    tablet: {},
                    mobile: {}
                  })}>{i18n(post.date)}</span>
                <p class={style({
                    base: {
                      fontSize: "var(--t-fs)",
                      letterSpacing: "var(--t-ls)",
                      fontWeight: "var(--t-fw)",
                      lineHeight: "var(--t-lh)",
                      color: "var(--text)",
                      marginTop: "4px"
                    },
                    tablet: {},
                    mobile: {}
                  })}>{i18n(post.description)}</p>
              </div>
            </Link>
          ))}
        </div>
      </container>
    </section>
    <Footer />
  </Layout>
</BaseLayout>
