---
import { getCollection } from 'astro:content';
import { getCollectionList, i18n } from 'meno-astro';
import { BaseLayout, Link, MenoImage } from 'meno-astro/components';
import FaqQuestion from '../components/FaqQuestion.astro';
import FeatureCard from '../components/FeatureCard.astro';
import Footer from '../components/Footer.astro';
import Layout from '../components/Layout.astro';
import Navigation from '../components/Navigation.astro';
import '../styles/theme.css';

const meta = { title: "starter-variables-01", description: "Created with Meno Studio" };

const blogList = await getCollectionList("blog", { sort: { field: "_createdAt", order: "desc" }, limit: 3 }, Astro, getCollection);
---
<BaseLayout meta={meta}>
  <Layout>
    <Navigation />
    <section class="p-(--s-p) bg-bg">
      <container class="m-auto block max-w-(--c-s)">
        <div class="m-auto flex flex-col items-center">
          <h1 class="mb-(--h-m) flex-row justify-start items-stretch max-w-[726px] text-text text-(length:--h-fs) font-(number:--h-fw) text-center leading-(--h-lh) tracking-(--h-ls)"><Fragment set:html={`Everything you <span class="custom-span">need</span> to build professional website`} /></h1>
          <p class="max-w-[500px] text-text text-(length:--t-fs) font-(number:--t-fw) text-center leading-(--t-lh) tracking-(--t-ls)">Design and publish professional websites without writing code. Start with this template and make it yours in minutes.</p>
          <div class="mt-(--b-m) flex flex-row justify-start items-stretch gap-3">
            <Link href="#" class="p-(--b-p) inline-flex flex-row justify-start items-stretch bg-accent text-[var(--white)] rounded-(--b-br) text-(length:--te-fs)">Button</Link>
            <Link href="#" class="p-(--b-p) inline-flex flex-row justify-start items-stretch bg-[var(--gray-200)] text-text rounded-(--b-br) text-(length:--te-fs)">Button</Link>
          </div>
        </div>
      </container>
    </section>
    <section class="p-(--s-p) bg-[var(--gray-100)]">
      <container class="m-auto block max-w-(--c-s)">
        <h2 class="mb-(--h-m) text-text text-(length:--he-fs) font-(number:--h-fw) leading-(--h-lh) tracking-(--h-ls)"><Fragment set:html={`This is <span class="custom-span">features</span> headline`} /></h2>
        <p class="max-w-[380px] text-text text-(length:--t-fs) font-(number:--t-fw) leading-(--t-lh) tracking-(--t-ls)">Short supporting description that previews how this section looks and reads in the editor</p>
        <div class="mt-10 grid gap-4 grid-cols-[1fr_1fr_1fr]">
          <FeatureCard description="This is description" text="Feature 1" />
          <FeatureCard description="This is description" text="Feature 2" />
          <FeatureCard description="This is description" text="Feature 3" />
        </div>
      </container>
    </section>
    <section class="p-(--s-p) bg-bg">
      <container class="m-auto block max-w-(--co-s)">
        <h2 class="mb-(--h-m) text-text text-(length:--he-fs) font-(number:--h-fw) tracking-(--h-ls)">Frequently asked questions</h2>
        <p class="text-text text-(length:--t-fs) font-(number:--t-fw) tracking-(--t-ls)">Short supporting description that previews how this section looks and reads in the editor.</p>
        <div class="mt-[60px] flex flex-col justify-between items-stretch">
          <FaqQuestion answer="Short supporting description that previews how this section looks and reads in the editor" question="First question" />
          <FaqQuestion question="Second question" answer="Short supporting description that previews how this section looks and reads in the editor" />
          <FaqQuestion question="Third question" answer="Short supporting description that previews how this section looks and reads in the editor" />
          <FaqQuestion question="Fourth question" answer="Short supporting description that previews how this section looks and reads in the editor" />
        </div>
      </container>
    </section>
    <section class="p-(--s-p) bg-[var(--gray-100)]">
      <container class="m-auto block max-w-(--c-s)">
        <div class="mb-[52px] flex flex-col justify-start items-center text-center">
          <span class="mb-(--s-m) text-text text-(length:--s-fs) font-(number:--s-fw) [text-transform:var(--subtitle)] tracking-(--s-ls)">Blog</span>
          <h2 class="mb-(--h-m) text-text text-(length:--h-fs) font-(number:--h-fw) text-center leading-(--h-lh) tracking-(--h-ls)">Latest articles</h2>
          <p class="max-w-[520px] text-text text-(length:--t-fs) font-(number:--t-fw) text-center leading-(--t-lh) tracking-(--t-ls)">Stay up to date with the latest news, tips, and insights.</p>
        </div>
        <div class="grid gap-4 grid-cols-[1fr_1fr_1fr]">
          {blogList.map((post, postIndex) => (
            <Link href={i18n(post._url)} class="flex flex-col justify-start items-stretch bg-bg text-text border-[1px_solid_var(--border)] rounded-[8px] no-underline overflow-hidden">
              <MenoImage src={i18n(post.image) || undefined} alt={i18n(post.title) || undefined} class="aspect-[16_/_10] object-cover" />
              <div class="p-6 flex flex-col items-start gap-3">
                <span class="p-[4px_12px] inline-block bg-[var(--gray-100)] text-text rounded-[999px] text-(length:--tex-fs) font-[500]">{i18n(post.category)}</span>
                <h3 class="m-[0] text-text text-(length:--head-fs) font-(number:--h-fw) leading-(--h-lh) tracking-(--h-ls)">{i18n(post.title)}</h3>
                <span class="text-muted text-(length:--te-fs) font-(number:--t-fw) tracking-(--t-ls)">{i18n(post.date)}</span>
                <p class="mt-1 text-text text-(length:--t-fs) font-(number:--t-fw) leading-(--t-lh) tracking-(--t-ls)">{i18n(post.description)}</p>
              </div>
            </Link>
          ))}
        </div>
      </container>
    </section>
    <Footer />
  </Layout>
</BaseLayout>
