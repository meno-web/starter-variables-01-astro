{
  "component": {
    "structure": {
      "type": "node",
      "tag": "div",
      "attributes": {
        "data-faq-item": "true"
      },
      "style": {
        "base": {
          "width": "100%",
          "borderBottom": "1px solid var(--border, #e0e0e0)"
        },
        "tablet": {},
        "mobile": {}
      },
      "children": [
        {
          "type": "node",
          "tag": "button",
          "attributes": {
            "data-faq-toggle": "true",
            "type": "button"
          },
          "style": {
            "base": {
              "width": "100%",
              "padding": "20px 0",
              "background": "transparent",
              "border": "none",
              "cursor": "pointer",
              "display": "flex",
              "justifyContent": "space-between",
              "alignItems": "center",
              "gap": "16px"
            },
            "tablet": {},
            "mobile": {}
          },
          "children": [
            {
              "type": "node",
              "tag": "h3",
              "style": {
                "base": {
                  "fontSize": "var(--hea-fs)",
                  "letterSpacing": "var(--h-ls)",
                  "fontWeight": "var(--h-fw)",
                  "lineHeight": "var(--h-lh)",
                  "color": "var(--text)",
                  "margin": "0",
                  "textAlign": "left",
                  "flex": "1"
                },
                "tablet": {},
                "mobile": {}
              },
              "children": [
                "{{question}}"
              ]
            },
            {
              "type": "node",
              "tag": "span",
              "attributes": {
                "data-faq-icon": "true"
              },
              "style": {
                "base": {
                  "fontSize": "20px",
                  "transition": "transform 0.3s ease",
                  "display": "flex",
                  "alignItems": "center",
                  "justifyContent": "center",
                  "color": "var(--text)",
                  "flexShrink": 0
                },
                "tablet": {},
                "mobile": {}
              },
              "children": [
                "+"
              ]
            }
          ]
        },
        {
          "type": "node",
          "tag": "div",
          "attributes": {
            "data-faq-answer": "true"
          },
          "style": {
            "base": {
              "maxHeight": "0",
              "overflow": "hidden",
              "transition": "max-height 0.3s ease, padding 0.3s ease",
              "paddingBottom": "0"
            },
            "tablet": {},
            "mobile": {}
          },
          "children": [
            {
              "type": "node",
              "tag": "p",
              "style": {
                "base": {
                  "fontSize": "var(--t-fs)",
                  "letterSpacing": "var(--t-ls)",
                  "fontWeight": "var(--t-fw)",
                  "lineHeight": "var(--t-lh)",
                  "color": "var(--text)",
                  "maxWidth": "530px",
                  "margin": "0 0 20px 0"
                },
                "tablet": {},
                "mobile": {}
              },
              "children": [
                "{{answer}}"
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "question": {
        "type": "string",
        "default": "First question"
      },
      "answer": {
        "type": "string",
        "default": "Short supporting description that previews how this section looks and reads in the editor"
      }
    }
  }
}