{
  "component": {
    "structure": {
      "type": "node",
      "tag": "div",
      "style": {
        "base": {
          "padding": "24px",
          "backgroundColor": "var(--bg)",
          "borderRadius": "8px"
        },
        "tablet": {},
        "mobile": {}
      },
      "children": [
        {
          "type": "node",
          "tag": "h3",
          "style": {
            "base": {
              "fontSize": "var(--hea-fs)",
              "letterSpacing": "var(--h-ls)",
              "fontWeight": "var(--h-fw)",
              "marginBottom": "var(--he-m)",
              "lineHeight": "var(--h-lh)",
              "color": "var(--text)"
            },
            "tablet": {},
            "mobile": {}
          },
          "children": [
            "{{text}}"
          ]
        },
        {
          "type": "node",
          "tag": "p",
          "style": {
            "base": {
              "fontSize": "var(--t-fs)",
              "letterSpacing": "var(--t-ls)",
              "fontWeight": "var(--t-fw)",
              "lineHeight": "var(--t-lh)",
              "color": "var(--text)"
            },
            "tablet": {},
            "mobile": {}
          },
          "children": [
            "{{description}}"
          ]
        }
      ]
    },
    "interface": {
      "text": {
        "type": "string",
        "default": "This is heading"
      },
      "description": {
        "type": "string",
        "default": "This is heading"
      }
    }
  }
}