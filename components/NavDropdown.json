{
  "component": {
    "structure": {
      "type": "node",
      "tag": "li",
      "label": "NavDropdown",
      "style": {
        "base": {
          "listStyle": "none",
          "position": "relative"
        }
      },
      "children": [
        {
          "type": "node",
          "tag": "button",
          "label": "Trigger",
          "style": {
            "base": {
              "color": "var(--text)",
              "fontSize": "var(--te-fs)",
              "letterSpacing": "var(--t-ls)",
              "fontWeight": "var(--t-fw)",
              "background": "none",
              "border": "none",
              "fontFamily": "inherit",
              "display": "flex",
              "alignItems": "center",
              "gap": "6px",
              "padding": "24px 12px",
              "cursor": "pointer",
              "transition": "opacity 0.2s"
            },
            "tablet": {
              "padding": "16px 0"
            },
            "mobile": {}
          },
          "interactiveStyles": [
            {
              "name": "hover",
              "prefix": "",
              "postfix": ":hover",
              "style": {
                "base": {
                  "opacity": "0.7"
                }
              }
            }
          ],
          "attributes": {
            "data-el": "trigger",
            "aria-expanded": "false",
            "aria-haspopup": "true"
          },
          "children": [
            {
              "type": "node",
              "tag": "span",
              "children": "{{text}}"
            },
            {
              "type": "embed",
              "html": "<svg width=\"12\" height=\"12\" viewBox=\"0 0 12 12\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M2.5 4.5L6 8L9.5 4.5\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>",
              "label": "Chevron",
              "style": {
                "base": {
                  "display": "flex",
                  "alignItems": "center",
                  "transition": "transform 0.2s ease"
                }
              },
              "interactiveStyles": [
                {
                  "name": "rotate on open",
                  "prefix": ".is-open ",
                  "postfix": "",
                  "style": {
                    "base": {
                      "transform": "rotate(180deg)"
                    }
                  }
                }
              ],
              "attributes": {
                "data-el": "chevron"
              }
            }
          ]
        },
        {
          "type": "node",
          "tag": "div",
          "label": "Panel",
          "style": {
            "base": {
              "display": "none",
              "position": "absolute",
              "top": "100%",
              "left": "-5px",
              "minWidth": "200px",
              "backgroundColor": "var(--bg)",
              "border": "1px solid var(--border)",
              "borderRadius": "8px",
              "boxShadow": "0 4px 16px rgba(0,0,0,0.08)",
              "zIndex": "200",
              "padding": "8px 0"
            },
            "tablet": {
              "position": "static",
              "border": "none",
              "borderRadius": "0",
              "boxShadow": "none",
              "padding": "0 0 0 16px",
              "minWidth": "unset",
              "backgroundColor": "transparent"
            },
            "mobile": {}
          },
          "interactiveStyles": [
            {
              "name": "show on open",
              "prefix": ".is-open ",
              "style": {
                "base": {
                  "display": "block"
                }
              },
              "previewProp": "isOpen"
            }
          ],
          "attributes": {
            "data-el": "panel"
          },
          "children": [
            {
              "type": "node",
              "tag": "ul",
              "label": "DropdownLinks",
              "style": {
                "base": {
                  "listStyle": "none",
                  "padding": "0",
                  "margin": "0",
                  "display": "flex",
                  "flexDirection": "column"
                }
              },
              "children": [
                {
                  "type": "slot"
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "text": {
        "type": "string",
        "default": "Dropdown"
      },
      "isOpen": {
        "type": "boolean",
        "default": false
      }
    },
    "defineVars": true
  }
}