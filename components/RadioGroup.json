{
  "component": {
    "structure": {
      "type": "node",
      "tag": "div",
      "style": {
        "base": {
          "display": "flex",
          "flexDirection": "column",
          "alignItems": "stretch",
          "gap": "8px",
          "width": "100%"
        },
        "tablet": {},
        "mobile": {}
      },
      "children": [
        {
          "type": "node",
          "tag": "span",
          "style": {
            "base": {
              "fontSize": "var(--te-fs)",
              "letterSpacing": "var(--t-ls)",
              "fontWeight": "500",
              "color": "var(--text)"
            },
            "tablet": {},
            "mobile": {}
          },
          "children": "{{label}}"
        },
        {
          "type": "node",
          "tag": "div",
          "style": {
            "base": {
              "display": "flex",
              "flexDirection": "column",
              "alignItems": "stretch",
              "gap": "8px"
            },
            "tablet": {},
            "mobile": {}
          },
          "children": [
            {
              "type": "list",
              "sourceType": "prop",
              "source": "options",
              "itemAs": "option",
              "children": [
                {
                  "type": "node",
                  "tag": "label",
                  "style": {
                    "base": {
                      "display": "flex",
                      "flexDirection": "row",
                      "justifyContent": "flex-start",
                      "alignItems": "center",
                      "gap": "10px",
                      "fontSize": "var(--te-fs)",
                      "color": "var(--text)",
                      "cursor": "pointer"
                    },
                    "tablet": {},
                    "mobile": {}
                  },
                  "children": [
                    {
                      "type": "node",
                      "tag": "input",
                      "style": {
                        "base": {
                          "width": "18px",
                          "height": "18px",
                          "accentColor": "var(--accent)",
                          "cursor": "pointer",
                          "margin": "0"
                        },
                        "tablet": {},
                        "mobile": {}
                      },
                      "attributes": {
                        "type": "radio",
                        "name": "{{inputName}}",
                        "value": "{{option.value}}",
                        "required": "{{required}}"
                      }
                    },
                    {
                      "type": "node",
                      "tag": "span",
                      "children": "{{option.label}}"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "label": {
        "type": "string",
        "default": "Choose one"
      },
      "inputName": {
        "type": "string",
        "default": "choice"
      },
      "required": {
        "type": "boolean",
        "default": false
      },
      "options": {
        "type": "list",
        "itemSchema": {
          "label": { "type": "string", "default": "Option" },
          "value": { "type": "string", "default": "option" }
        },
        "default": [
          { "label": "Option 1", "value": "option-1" },
          { "label": "Option 2", "value": "option-2" },
          { "label": "Option 3", "value": "option-3" }
        ]
      }
    }
  }
}
