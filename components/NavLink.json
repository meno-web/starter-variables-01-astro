{
  "component": {
    "structure": {
      "type": "node",
      "tag": "li",
      "style": {
        "base": {
          "listStyle": "none"
        }
      },
      "children": [
        {
          "type": "link",
          "href": "{{link}}",
          "style": {
            "base": {
              "color": "var(--text)",
              "fontSize": "var(--te-fs)",
              "letterSpacing": "var(--t-ls)",
              "fontWeight": "var(--t-fw)",
              "textDecoration": "none",
              "display": "block",
              "padding": "24px 12px",
              "transition": "opacity 0.2s",
              "cursor": "pointer"
            },
            "tablet": {
              "padding": "16px 0"
            },
            "mobile": {}
          },
          "interactiveStyles": [
            {
              "name": "hover",
              "prefix": "",
              "postfix": ":hover",
              "style": {
                "base": {
                  "opacity": "0.7"
                }
              }
            }
          ],
          "children": "{{text}}"
        }
      ]
    },
    "interface": {
      "text": {
        "type": "string",
        "default": "Link"
      },
      "link": {
        "type": "link"
      }
    }
  }
}