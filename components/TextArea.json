{
  "component": {
    "structure": {
      "type": "node",
      "tag": "div",
      "style": {
        "base": {
          "display": "flex",
          "flexDirection": "column",
          "alignItems": "stretch",
          "gap": "8px",
          "width": "100%"
        },
        "tablet": {},
        "mobile": {}
      },
      "children": [
        {
          "type": "node",
          "tag": "label",
          "style": {
            "base": {
              "fontSize": "var(--te-fs)",
              "letterSpacing": "var(--t-ls)",
              "fontWeight": "500",
              "color": "var(--text)"
            },
            "tablet": {},
            "mobile": {}
          },
          "attributes": {
            "for": "{{inputId}}"
          },
          "children": "{{label}}"
        },
        {
          "type": "node",
          "tag": "textarea",
          "style": {
            "base": {
              "padding": "12px 16px",
              "fontSize": "var(--te-fs)",
              "color": "var(--text)",
              "backgroundColor": "var(--bg)",
              "border": "1px solid",
              "borderRadius": "var(--b-br)",
              "outline": "none",
              "width": "100%",
              "resize": "vertical",
              "fontFamily": "inherit",
              "lineHeight": "var(--t-lh)",
              "borderColor": "var(--border)"
            },
            "tablet": {},
            "mobile": {}
          },
          "attributes": {
            "id": "{{inputId}}",
            "name": "{{inputName}}",
            "placeholder": "{{placeholder}}",
            "rows": "{{rows}}",
            "required": "{{required}}"
          }
        }
      ]
    },
    "interface": {
      "label": {
        "type": "string",
        "default": "Label"
      },
      "inputId": {
        "type": "string",
        "default": "message"
      },
      "inputName": {
        "type": "string",
        "default": "message"
      },
      "placeholder": {
        "type": "string",
        "default": "Type here..."
      },
      "rows": {
        "type": "number",
        "default": 6
      },
      "required": {
        "type": "boolean",
        "default": false
      }
    }
  }
}
