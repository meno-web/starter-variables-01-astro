{
  "component": {
    "structure": {
      "type": "node",
      "tag": "div",
      "style": {
        "base": {
          "display": "flex",
          "flexDirection": "column",
          "alignItems": "stretch",
          "gap": "8px",
          "width": "100%"
        },
        "tablet": {},
        "mobile": {}
      },
      "children": [
        {
          "type": "node",
          "tag": "label",
          "style": {
            "base": {
              "fontSize": "var(--te-fs)",
              "letterSpacing": "var(--t-ls)",
              "fontWeight": "500",
              "color": "var(--text)"
            },
            "tablet": {},
            "mobile": {}
          },
          "attributes": {
            "for": "{{inputId}}"
          },
          "children": "{{label}}"
        },
        {
          "type": "node",
          "tag": "select",
          "style": {
            "base": {
              "padding": "12px 16px",
              "fontSize": "var(--te-fs)",
              "color": "var(--text)",
              "backgroundColor": "var(--bg)",
              "border": "1px solid",
              "borderRadius": "var(--b-br)",
              "outline": "none",
              "width": "100%",
              "borderColor": "var(--border)",
              "cursor": "pointer",
              "appearance": "none"
            },
            "tablet": {},
            "mobile": {}
          },
          "attributes": {
            "id": "{{inputId}}",
            "name": "{{inputName}}",
            "required": "{{required}}"
          },
          "children": [
            {
              "type": "list",
              "sourceType": "prop",
              "source": "options",
              "itemAs": "option",
              "children": [
                {
                  "type": "node",
                  "tag": "option",
                  "attributes": {
                    "value": "{{option.value}}"
                  },
                  "children": "{{option.label}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "label": {
        "type": "string",
        "default": "Select"
      },
      "inputId": {
        "type": "string",
        "default": "select"
      },
      "inputName": {
        "type": "string",
        "default": "select"
      },
      "required": {
        "type": "boolean",
        "default": false
      },
      "options": {
        "type": "list",
        "itemSchema": {
          "label": { "type": "string", "default": "Option" },
          "value": { "type": "string", "default": "option" }
        },
        "default": [
          { "label": "Select an option", "value": "" },
          { "label": "Option 1", "value": "option-1" },
          { "label": "Option 2", "value": "option-2" }
        ]
      }
    }
  }
}
