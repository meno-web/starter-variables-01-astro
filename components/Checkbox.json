{
  "component": {
    "structure": {
      "type": "node",
      "tag": "label",
      "style": {
        "base": {
          "display": "flex",
          "flexDirection": "row",
          "justifyContent": "flex-start",
          "alignItems": "center",
          "gap": "10px",
          "fontSize": "var(--te-fs)",
          "letterSpacing": "var(--t-ls)",
          "fontWeight": "500",
          "color": "var(--text)",
          "cursor": "pointer",
          "width": "100%"
        },
        "tablet": {},
        "mobile": {}
      },
      "attributes": {
        "for": "{{inputId}}"
      },
      "children": [
        {
          "type": "node",
          "tag": "input",
          "style": {
            "base": {
              "width": "18px",
              "height": "18px",
              "accentColor": "var(--accent)",
              "cursor": "pointer",
              "margin": "0"
            },
            "tablet": {},
            "mobile": {}
          },
          "attributes": {
            "type": "checkbox",
            "id": "{{inputId}}",
            "name": "{{inputName}}",
            "value": "{{value}}",
            "checked": "{{checked}}",
            "required": "{{required}}"
          }
        },
        {
          "type": "node",
          "tag": "span",
          "children": "{{label}}"
        }
      ]
    },
    "interface": {
      "label": {
        "type": "string",
        "default": "I agree to the terms"
      },
      "inputId": {
        "type": "string",
        "default": "checkbox"
      },
      "inputName": {
        "type": "string",
        "default": "checkbox"
      },
      "value": {
        "type": "string",
        "default": "yes"
      },
      "checked": {
        "type": "boolean",
        "default": false
      },
      "required": {
        "type": "boolean",
        "default": false
      }
    }
  }
}
